# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# IDE / editor
.idea/
.vscode/

# OS junk
Thumbs.db
Desktop.ini

# flq output artifacts (decoded dirs are produced by `flq decode`;
# testdata/ fixture .flq files stay tracked)
*.flq
*_decoded/
!testdata/*.flq
/sample_pack
